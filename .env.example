# =============================================================================
# ARKA TECHNOLOGIES - variaveis de ambiente
#
# Copie para .env.local e preencha. NENHUMA e obrigatoria para o site rodar:
# sem configuracao, o site funciona com o conteudo de src/content e sem
# rastreamento. Ver docs/ARCHITECTURE.md.
# =============================================================================

# -----------------------------------------------------------------------------
# Rastreamento de anuncios (Google Ads, Analytics, Tag Manager)
#
# Deixe em branco o que nao usar: o script correspondente nao e injetado.
# Depois da Parte 7, estes valores tambem poderao ser editados pelo painel,
# e o que estiver no banco tem prioridade sobre o que esta aqui.
# -----------------------------------------------------------------------------

# ID do Google Ads. Formato: AW-XXXXXXXXXX
NEXT_PUBLIC_GOOGLE_ADS_ID=

# Rotulo da acao de conversao, copiado da tela do Google Ads.
# Formato: AW-XXXXXXXXXX/abcDEFghiJKL
NEXT_PUBLIC_GOOGLE_ADS_CONVERSAO=

# Google Analytics 4. Formato: G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=

# Google Tag Manager. Formato: GTM-XXXXXXX
NEXT_PUBLIC_GTM_ID=

# Desliga todo o rastreamento de uma vez, sem apagar os ids acima.
# Qualquer valor diferente de "false" mantem ligado.
NEXT_PUBLIC_RASTREAMENTO_ATIVO=true

# -----------------------------------------------------------------------------
# Supabase. Ver docs/SETUP-SUPABASE.md.
# Use a Project URL em NEXT_PUBLIC_SUPABASE_URL e a publishable key
# (sb_publishable_...) abaixo. A anon key antiga continua aceita.
# -----------------------------------------------------------------------------

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Opcional, apenas para operacoes administrativas restritas no servidor.
# NUNCA exponha esta chave no cliente nem commite preenchida.
SUPABASE_SERVICE_ROLE_KEY=
